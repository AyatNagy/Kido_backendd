generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique @db.VarChar(100)
  password         String    @db.VarChar(255)
  name             String    @db.VarChar(100)
  email            String    @unique @db.VarChar(100)
  phone            String?   @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  resetToken       String?
  resetTokenExpiry DateTime?
  isVerified       Boolean   @default(false) @map("is_verified")

  userRoles UserRole[]
  children  Child[]

  @@map("users")
}

model Child {
  id           Int          @id @default(autoincrement())
  motherId     Int          @map("mother_id")
  username     String       @unique @db.VarChar(100)
  password     String       @db.VarChar(255)
  name         String       @db.VarChar(100)
  dateOfBirth  DateTime?    @map("date_of_birth") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  allowedLevel Int          @default(1)
  mother       User         @relation(fields: [motherId], references: [id], onDelete: Cascade)
  progress     Progress[]
  assessments  Assessment[]

  @@map("children")
}

model Level {
  id          Int        @id @default(autoincrement())
  levelNumber Int        @unique @map("level_number") 
  name        String     @db.VarChar(50)
  categories  Category[]

  @@map("levels")
}

model Category {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  levelId      Int     @map("level_id")
  totalLessons Int     @default(0) @map("total_lessons")

  level   Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("categories")
}

model Lesson {
  id         Int        @id @default(autoincrement())
  categoryId Int        @map("category_id")
  title      String     @db.VarChar(100)
  content    String?    @db.Text
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  progress   Progress[]

  @@map("lessons")
}

model Progress {
  id          Int      @id @default(autoincrement())
  childId     Int      @map("child_id")
  lessonId    Int      @map("lesson_id")
  isCompleted Boolean  @default(false) @map("is_completed")
  completedAt DateTime @default(now()) @updatedAt @map("completed_at")

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([childId, lessonId])
  @@map("progress")
}

model Role {
  roleId          Int        @id @default(autoincrement()) @map("role_id")
  roleName        String     @unique @map("role_name") @db.VarChar(50)
  roleDescription String?    @map("role_description") @db.VarChar(255)
  userRoles       UserRole[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [roleId], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Assessment {
  id        Int      @id @default(autoincrement())
  childId   Int      @map("child_id")
  score     Int
  level     Int
  createdAt DateTime @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("assessments")
}
