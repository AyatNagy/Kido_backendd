// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique @db.VarChar(100)
  password   String     @db.VarChar(255)
  name       String     @db.VarChar(100)
  email      String     @unique @db.VarChar(100)
  phone      String?    @db.VarChar(20)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamp(0)

  userRoles  UserRole[]
  children   Child[] 

  @@map("users")
}

model Role {
  roleId          Int        @id @default(autoincrement()) @map("role_id")
  roleName        String     @unique @db.VarChar(50) @map("role_name")
  roleDescription String?    @db.VarChar(255) @map("role_description")

  userRoles       UserRole[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [roleId], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Course {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  lessons     Lesson[]
  exams       Exam[]
  childCourses ChildCourse[]
  progress    Progress[]

  @@map("courses")
}

model Lesson {
  id          Int         @id @default(autoincrement())
  courseId    Int         @map("course_id")
  title       String      @db.VarChar(100)
  content     String?     @db.Text
  orderNumber Int         @map("order_number")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(0)

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@map("lessons")
}

model Assignment {
  id          Int       @id @default(autoincrement())
  lessonId    Int       @map("lesson_id")
  title       String    @db.VarChar(100)
  description String?   @db.Text
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress    Progress[]

  @@map("assignments")
}

model Exam {
  id            Int       @id @default(autoincrement())
  courseId      Int       @map("course_id")
  title         String    @db.VarChar(100)
  description   String?   @db.Text
  scheduledDate DateTime? @map("scheduled_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  childExams    ChildExam[]
  progress      Progress[]

  @@map("exams")
}

model Child {
  id          Int        @id @default(autoincrement())
  motherId    Int        @map("mother_id")
  username    String     @unique @db.VarChar(100)
  password    String     @db.VarChar(255)
  name        String     @db.VarChar(100)
  dateOfBirth DateTime?  @map("date_of_birth") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(0)

  mother      User       @relation(fields: [motherId], references: [id], onDelete: Cascade)
  childCourses ChildCourse[]
  childExams  ChildExam[]
  progress    Progress[]

  @@map("children")
}

model ChildCourse {
  childId    Int      @map("child_id")
  courseId   Int      @map("course_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamp(0)

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([childId, courseId])
  @@map("child_courses")
}

model ChildExam {
  id       Int       @id @default(autoincrement())
  childId  Int       @map("child_id")
  examId   Int       @map("exam_id")
  takenAt  DateTime  @default(now()) @map("taken_at") @db.Timestamp(0)
  score    Float?

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("child_exams")
}

model Progress {
  id                 Int       @id @default(autoincrement())
  childId            Int       @map("child_id")
  courseId           Int       @map("course_id")
  assignmentId       Int?      @map("assignment_id")
  examId             Int?      @map("exam_id")
  grade              String?   @db.VarChar(5)
  assignmentCompleted Boolean   @default(false) @map("assignment_completed")
  examScore          Float?    @map("exam_score")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  child      Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  exam       Exam?       @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@map("progress")
}
